# MongoDB (document store)
MONGODB_URI=mongodb://audit_user:audit_pass@localhost:27017/audit_rag?authSource=admin

# S3 / MinIO (object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=audit_minio
S3_SECRET_KEY=audit_minio_pass
