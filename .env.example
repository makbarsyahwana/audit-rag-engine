# Neo4j (unified vector + graph + fulltext)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=audit_pass

# MongoDB (document store)
MONGODB_URI=mongodb://audit_user:audit_pass@localhost:27017/audit_rag?authSource=admin

# S3 / MinIO (object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=audit_minio
S3_SECRET_KEY=audit_minio_pass
S3_BUCKET=audit-documents

# ── Provider abstraction ──────────────────────────────────────────────────────
# Single key for OpenRouter (covers all tiers + embeddings via one gateway).
# Leave blank if you set per-tier keys or use OPENAI_API_KEY directly.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Legacy OpenAI key — only needed if NOT using OpenRouter
OPENAI_API_KEY=

# ── 🟢 Small tier — Qwen3-8B (classifier, sub_RLM leaf calls) ────────────────
SMALL_MODEL_PROVIDER=openai_compatible
SMALL_MODEL_NAME=qwen/qwen3-8b
SMALL_MODEL_BASE_URL=https://openrouter.ai/api/v1
# SMALL_MODEL_API_KEY=   # optional: defaults to OPENROUTER_API_KEY

# ── 🟡 Mid tier — DeepSeek-V3 (planner, critic, RLM controller) ──────────────
MID_MODEL_PROVIDER=openai_compatible
MID_MODEL_NAME=deepseek/deepseek-chat-v3-0324
MID_MODEL_BASE_URL=https://openrouter.ai/api/v1
# MID_MODEL_API_KEY=

# ── 🔴 Frontier tier — Claude Sonnet 4.5 (synthesis, final answers) ──────────
FRONTIER_MODEL_PROVIDER=openai_compatible
FRONTIER_MODEL_NAME=anthropic/claude-sonnet-4-5
FRONTIER_MODEL_BASE_URL=https://openrouter.ai/api/v1
# FRONTIER_MODEL_API_KEY=

# ── Embeddings — Qwen3-Embedding-8B via OpenRouter ───────────────────────────
# MRL: EMBEDDING_DIMENSIONS=1536 matches existing HNSW index (no re-index needed).
# Upgrade to 4096 for higher quality — requires dropping + recreating Neo4j indexes
# and re-ingesting all documents.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=

# ── RLM engine ────────────────────────────────────────────────────────────────
RLM_MAX_ITERATIONS=15
RLM_MAX_DEPTH=3
RLM_MAX_SUB_CALLS=50

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
